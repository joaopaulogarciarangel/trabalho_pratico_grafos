# Testes de ponta a ponta dos programas `grafos` e `estudos` (executado por ctest).
# Variaveis: GRAFOS, ESTUDOS, DADOS (tests/dados), TMP (pasta de trabalho).

file(REMOVE_RECURSE "${TMP}")
file(MAKE_DIRECTORY "${TMP}")

function(rodar esperado_codigo)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE codigo OUTPUT_VARIABLE saida ERROR_VARIABLE erro)
    if(NOT "${codigo}" STREQUAL "${esperado_codigo}")
        message(FATAL_ERROR "codigo ${codigo} (esperado ${esperado_codigo}) em: ${ARGN}\nsaida:\n${saida}\nerro:\n${erro}")
    endif()
    set(SAIDA "${saida}" PARENT_SCOPE)
    set(ERRO "${erro}" PARENT_SCOPE)
endfunction()

function(exigir_texto texto trecho)
    string(FIND "${texto}" "${trecho}" pos)
    if(pos EQUAL -1)
        message(FATAL_ERROR "trecho nao encontrado: '${trecho}'\nem:\n${texto}")
    endif()
endfunction()

function(comparar arquivo esperado)
    file(READ "${arquivo}" conteudo)
    if(NOT conteudo STREQUAL esperado)
        message(FATAL_ERROR "conteudo de ${arquivo} difere.\nobtido:\n${conteudo}\nesperado:\n${esperado}")
    endif()
endfunction()

set(FIG "${DADOS}/figura1.txt")
set(EST_ESPERADO "# Estatisticas do grafo\nvertices: 5\narestas: 5\ngrau_minimo: 1\ngrau_maximo: 4\ngrau_medio: 2.0000\nmediana_grau: 2.0\n\n# Componentes conexas\nnum_componentes: 1\n\ncomponente 1 (tamanho 5):\n1 2 3 4 5\n")
set(BFS_ESPERADO "# BFS raiz=1\n# vertice pai nivel ordem\n1 0 0 1\n2 1 1 2\n3 5 2 4\n4 5 2 5\n5 1 1 3\n")
set(DFS_ESPERADO "# DFS raiz=1\n# vertice pai nivel ordem\n1 0 0 1\n2 1 1 2\n3 5 3 4\n4 5 3 5\n5 2 2 3\n")

foreach(repr lista matriz)
    rodar(0 "${GRAFOS}" estatisticas "${FIG}" --repr ${repr} -o "${TMP}/est_${repr}.txt")
    exigir_texto("${SAIDA}" "n = 5, m = 5")
    comparar("${TMP}/est_${repr}.txt" "${EST_ESPERADO}")
    rodar(0 "${GRAFOS}" bfs "${FIG}" --origem 1 --repr ${repr} -o "${TMP}/bfs_${repr}.txt")
    comparar("${TMP}/bfs_${repr}.txt" "${BFS_ESPERADO}")
    rodar(0 "${GRAFOS}" dfs "${FIG}" --repr ${repr} --origem 1 -o "${TMP}/dfs_${repr}.txt")
    comparar("${TMP}/dfs_${repr}.txt" "${DFS_ESPERADO}")
    rodar(0 "${GRAFOS}" distancia "${FIG}" 3 4 --repr ${repr} --caminho)
    exigir_texto("${SAIDA}" "distancia(3, 4) = 2")
    exigir_texto("${SAIDA}" "caminho: 3 5 4")
    foreach(alg --ingenuo --aproximado --exato)
        rodar(0 "${GRAFOS}" diametro "${FIG}" --repr ${repr} ${alg})
        exigir_texto("${SAIDA}" "diametro: 2\n")
        exigir_texto("${SAIDA}" "exato: sim")
    endforeach()
endforeach()

