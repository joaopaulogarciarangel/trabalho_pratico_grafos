    exigir_texto("${csv}" "chave,valor\n")
    exigir_texto("${csv}" "representacao,${repr}\n")
    exigir_texto("${csv}" "memoria_status,ok\n")
    exigir_texto("${csv}" "num_buscas,8\n")
    exigir_texto("${csv}" "pai_dfs_raiz3_v10,inexistente\n")
    exigir_texto("${csv}" "dist_10_20,inexistente\n")
    exigir_texto("${csv}" "num_componentes,5\n")
    exigir_texto("${csv}" "maior_componente,3\n")
    exigir_texto("${csv}" "menor_componente,1\n")
    if(NOT EXISTS "${TMP}/res/desconexo_${repr}_estatisticas.txt" OR EXISTS "${TMP}/res/desconexo_${repr}.csv.tmp")
        message(FATAL_ERROR "arquivos de saida do estudos inesperados (${repr})")
    endif()
endforeach()
