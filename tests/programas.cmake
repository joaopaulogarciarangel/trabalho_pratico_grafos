rodar(1 "${GRAFOS}" estatisticas "${TMP}/enorme.txt" --repr matriz -o "${TMP}/x.txt")
exigir_texto("${ERRO}" "matriz exigiria")

# Lista com n absurdo: recusada so pelo n, antes de alocar. Roda sob ulimit -v para que, se a
# checagem falhar, o erro seja bad_alloc e nao um OOM do WSL. Pulado com sanitizers (ASan
# reserva memoria virtual demais para funcionar com ulimit -v).
if(NOT SANITIZERS)
    set(LIMITADO sh -c "ulimit -v 4000000 && exec \"$0\" \"$@\"")
    rodar(1 ${LIMITADO} "${GRAFOS}" estatisticas "${TMP}/enorme.txt" -o "${TMP}/x.txt")
    exigir_texto("${ERRO}" "lista exigiria pelo menos")
    rodar(1 ${LIMITADO} "${ESTUDOS}" --grafo "${TMP}/enorme.txt" --repr lista --saida "${TMP}/res")
    exigir_texto("${ERRO}" "lista exigiria pelo menos")
endif()

# estudos: lista e matriz no grafo desconexo (n < 30: vertices 10, 20, 30 inexistentes)
foreach(repr lista matriz)
    rodar(0 "${ESTUDOS}" --grafo "${TMP}/desconexo.txt" --repr ${repr} --saida "${TMP}/res" --semente 7)
